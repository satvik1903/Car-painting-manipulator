<?xml version="1.0" ?>
<!-- =========================================================================
  paint_booth.sdf
  Gazebo Harmonic world built from the Yuktii reference layout (page 2).

  Frame (same as our Python planning scripts and the robot):
    origin = centre of the car's parking spot on the floor
    x      = along the conveyor (car enters at -x, leaves at +x)
    y      = across the booth (+y is the far glass wall)
    z      = up
    units  = metres

  Layout (approximate, the drawing is "a general reference only"):
    Entry zone   x -6 .. -4   y -2.5 .. 2.5   (2 x 5 m)
    Paint booth  x -4 ..  4   y -2.5 .. 2.5   (8 x 5 m)
    Exit zone    x  4 ..  6   y -2.5 .. 2.5   (2 x 5 m)
    Overall      about 12 x 5 m (booth zone only)

  Change from the reference drawing: the support rooms (paint mixing,
  control, storage) are outside the robot cell's scope and are omitted.
  Both long walls are glass viewing windows, as in real booths, so the
  painting can be watched from either side without entering the spray area.

  SDF vs URDF: URDF describes ONE robot. SDF can describe a whole WORLD:
  physics settings, lights, the ground, and any number of models.
========================================================================== -->
<sdf version="1.9">
  <world name="paint_booth">

    <!-- =====================================================================
      Physics: how the simulator steps time.
      max_step_size 0.001 = 1 ms per step (1000 steps per simulated second).
      real_time_factor 1  = try to run as fast as real time, not faster.
    ====================================================================== -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- =====================================================================
      System plugins. A custom world must list these itself; empty.sdf had
      them built in, which is why we never saw them before.
        Physics          -> gravity, joints, collisions actually happen
        UserCommands     -> lets other programs ADD models. Our robot spawner
                            (ros_gz_sim create) needs this, or spawning fails.
        SceneBroadcaster -> sends the scene to the GUI. Without it the
                            Gazebo window opens but shows nothing.
    ====================================================================== -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.81</gravity>

    <!-- =====================================================================
      Light: a "sun" shining down at an angle so walls cast shadows and
      edges are easy to see in screenshots and the demo video.
    ====================================================================== -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <!-- =====================================================================
      Ground plane: an infinite flat floor with collision, so nothing
      falls forever. static = true means it never moves.
    ====================================================================== -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- =====================================================================
      The building. One STATIC model with one link holding every wall.
      static = true: physics treats it as fixed scenery, so it costs
      almost nothing to simulate and cannot be knocked over.

      Every wall below is a box:  <size> length_x length_y height </size>
      and its <pose> is its CENTRE:  x y z roll pitch yaw
      Walls are 4.5 m tall (centre z = 2.25), above the planned 3.8 m
      gantry rails, and 0.2 m thick.
    ====================================================================== -->
    <model name="paint_booth_building">
      <static>true</static>
      <link name="structure">

        <!-- ========== Front outer wall (y = -2.6), see-through ========== -->
        <!-- This is the wall between the camera and the robot, so it is
             mostly transparent. Otherwise it would block every view. -->
        <collision name="wall_front_col">
          <pose>0 -2.6 2.25 0 0 0</pose>
          <geometry><box><size>12.4 0.2 4.5</size></box></geometry>
        </collision>
        <visual name="wall_front_vis">
          <pose>0 -2.6 2.25 0 0 0</pose>
          <geometry><box><size>12.4 0.2 4.5</size></box></geometry>
          <transparency>0.8</transparency>
          <material>
            <ambient>0.7 0.8 0.9 1</ambient>
            <diffuse>0.7 0.8 0.9 1</diffuse>
          </material>
        </visual>

        <!-- ========== Back outer wall (y = 2.6), see-through ========== -->
        <!-- Viewing window on the far side of the car, so painting can be
             watched from both sides. Replaces the support rooms. -->
        <collision name="wall_back_glass_col">
          <pose>0 2.6 2.25 0 0 0</pose>
          <geometry><box><size>12.4 0.2 4.5</size></box></geometry>
        </collision>
        <visual name="wall_back_glass_vis">
          <pose>0 2.6 2.25 0 0 0</pose>
          <geometry><box><size>12.4 0.2 4.5</size></box></geometry>
          <transparency>0.8</transparency>
          <material>
            <ambient>0.7 0.8 0.9 1</ambient>
            <diffuse>0.7 0.8 0.9 1</diffuse>
          </material>
        </visual>

        <!-- ========== Left outer wall (x = -6.1) with the car ENTRY opening ==========
             The arrow on the drawing: the car comes in here. The wall is
             split into two pieces with a 3 m gap between y = -1.5 and 1.5
             (car width 1.9 m plus clearance). -->
        <collision name="wall_left_a_col">
          <pose>-6.1 -2.1 2.25 0 0 0</pose>
          <geometry><box><size>0.2 1.2 4.5</size></box></geometry>
        </collision>
        <visual name="wall_left_a_vis">
          <pose>-6.1 -2.1 2.25 0 0 0</pose>
          <geometry><box><size>0.2 1.2 4.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>
        <collision name="wall_left_b_col">
          <pose>-6.1 2.1 2.25 0 0 0</pose>
          <geometry><box><size>0.2 1.2 4.5</size></box></geometry>
        </collision>
        <visual name="wall_left_b_vis">
          <pose>-6.1 2.1 2.25 0 0 0</pose>
          <geometry><box><size>0.2 1.2 4.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>

        <!-- ========== Right outer wall (x = 6.1) with the car EXIT opening ========== -->
        <collision name="wall_right_a_col">
          <pose>6.1 -2.1 2.25 0 0 0</pose>
          <geometry><box><size>0.2 1.2 4.5</size></box></geometry>
        </collision>
        <visual name="wall_right_a_vis">
          <pose>6.1 -2.1 2.25 0 0 0</pose>
          <geometry><box><size>0.2 1.2 4.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>
        <collision name="wall_right_b_col">
          <pose>6.1 2.1 2.25 0 0 0</pose>
          <geometry><box><size>0.2 1.2 4.5</size></box></geometry>
        </collision>
        <visual name="wall_right_b_vis">
          <pose>6.1 2.1 2.25 0 0 0</pose>
          <geometry><box><size>0.2 1.2 4.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material>
        </visual>

        <!-- ========== Columns at the booth boundaries (x = -4 and x = 4) ==========
             The small squares on the drawing. They mark where the entry
             and exit zones end and the paint booth begins. 0.3 x 0.3 m. -->
        <collision name="col_entry_front_col">
          <pose>-4 -2.35 2.25 0 0 0</pose>
          <geometry><box><size>0.3 0.3 4.5</size></box></geometry>
        </collision>
        <visual name="col_entry_front_vis">
          <pose>-4 -2.35 2.25 0 0 0</pose>
          <geometry><box><size>0.3 0.3 4.5</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
        <collision name="col_entry_back_col">
          <pose>-4 2.35 2.25 0 0 0</pose>
          <geometry><box><size>0.3 0.3 4.5</size></box></geometry>
        </collision>
        <visual name="col_entry_back_vis">
          <pose>-4 2.35 2.25 0 0 0</pose>
          <geometry><box><size>0.3 0.3 4.5</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
        <collision name="col_exit_front_col">
          <pose>4 -2.35 2.25 0 0 0</pose>
          <geometry><box><size>0.3 0.3 4.5</size></box></geometry>
        </collision>
        <visual name="col_exit_front_vis">
          <pose>4 -2.35 2.25 0 0 0</pose>
          <geometry><box><size>0.3 0.3 4.5</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>
        <collision name="col_exit_back_col">
          <pose>4 2.35 2.25 0 0 0</pose>
          <geometry><box><size>0.3 0.3 4.5</size></box></geometry>
        </collision>
        <visual name="col_exit_back_vis">
          <pose>4 2.35 2.25 0 0 0</pose>
          <geometry><box><size>0.3 0.3 4.5</size></box></geometry>
          <material><ambient>0.4 0.4 0.45 1</ambient><diffuse>0.4 0.4 0.45 1</diffuse></material>
        </visual>

        <!-- ========== Floor markings: VISUAL ONLY, no collision ==========
             Very thin coloured boxes lying on the floor, so the zones are
             easy to read in screenshots. No <collision>, so nothing can
             bump into them. Slightly different heights stop them flickering
             where they overlap. -->
        <visual name="floor_entry">
          <pose>-5 0 0.002 0 0 0</pose>
          <geometry><box><size>2 5 0.004</size></box></geometry>
          <material><ambient>0.85 0.75 0.3 1</ambient><diffuse>0.85 0.75 0.3 1</diffuse></material>
        </visual>
        <visual name="floor_booth">
          <pose>0 0 0.002 0 0 0</pose>
          <geometry><box><size>8 5 0.004</size></box></geometry>
          <material><ambient>0.6 0.62 0.66 1</ambient><diffuse>0.6 0.62 0.66 1</diffuse></material>
        </visual>
        <visual name="floor_exit">
          <pose>5 0 0.002 0 0 0</pose>
          <geometry><box><size>2 5 0.004</size></box></geometry>
          <material><ambient>0.4 0.7 0.45 1</ambient><diffuse>0.4 0.7 0.45 1</diffuse></material>
        </visual>
        <!-- Where the 4.8 x 1.9 m car stops for painting. -->
        <visual name="floor_car_spot">
          <pose>0 0 0.005 0 0 0</pose>
          <geometry><box><size>4.8 1.9 0.004</size></box></geometry>
          <material><ambient>0.3 0.3 0.33 1</ambient><diffuse>0.3 0.3 0.33 1</diffuse></material>
        </visual>
        <!-- Conveyor centre line, entry wall to exit wall. -->
        <visual name="floor_conveyor_line">
          <pose>0 0 0.008 0 0 0</pose>
          <geometry><box><size>12 0.08 0.004</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>

      </link>
    </model>


    <!-- =====================================================================
      Car body on a skid, standing on the roller conveyor.

      Factory paint lines carry the bare body ("body in white") on a steel
      frame called a SKID. The skid rides on a roller conveyor that runs
      from the entry opening to the exit opening, and stops at the paint spot.

      Heights (metres, from the floor):
        0.00 .. 0.05   conveyor rails      (visual only)
        0.05 .. 0.15   skid runners        (two long bars the skid slides on)
        0.15 .. 0.23   sill cross bars     (reach out under the sills)
        0.23 .. 0.375  skid posts          (meet the measured sill edges)
        0.337 .. 1.60  car body            (1.263 m tall, from prepare_car.py;
                                            lowest point 0.337, sills at ~0.375)
      So body + skid = 1.6 m overall, as the brief asks.

      NOSE DIRECTION: the car should face +x (toward the green exit zone).
      If the hood points at the yellow entry zone instead, change the yaw
      (last number) of the car's two <pose> lines from 0 to 3.14159.

      Static for now: the car parks at x = 0. Making the conveyor actually
      move the car is a stretch goal for the demo video.
    ====================================================================== -->
    <model name="car_on_skid">
      <static>true</static>
      <link name="body">

        <!-- ===== The car body: detailed mesh for looks, simple mesh for collisions ===== -->
        <!-- Same origin trick as before: prepare_car.py put the body's bottom
             at z = 0, so lifting it by the skid height (0.337) seats it on the posts. -->
        <visual name="car_visual">
          <pose>0 0 0.337 0 0 0</pose>
          <geometry>
            <mesh><uri>package://yuktiikuka/meshes/car/car_visual.stl</uri></mesh>
          </geometry>
          <!-- Light grey-blue, like the electro-coat primer a body has before painting -->
          <material>
            <ambient>0.62 0.66 0.72 1</ambient>
            <diffuse>0.62 0.66 0.72 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
        <collision name="car_collision">
          <pose>0 0 0.337 0 0 0</pose>
          <geometry>
            <mesh><uri>package://yuktiikuka/meshes/car/car_collision.stl</uri></mesh>
          </geometry>
        </collision>

        <!-- ===== Skid runners: two long bars along x ===== -->
        <!-- 4.4 m long, 0.10 m wide, 0.10 m tall, centred at z = 0.10 (0.05 .. 0.15),
             0.55 m either side of the centre line: under the car's sills. -->
        <visual name="runner_left_vis">
          <pose>0 0.55 0.10 0 0 0</pose>
          <geometry><box><size>4.4 0.10 0.10</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
        <collision name="runner_left_col">
          <pose>0 0.55 0.10 0 0 0</pose>
          <geometry><box><size>4.4 0.10 0.10</size></box></geometry>
        </collision>
        <visual name="runner_right_vis">
          <pose>0 -0.55 0.10 0 0 0</pose>
          <geometry><box><size>4.4 0.10 0.10</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
        <collision name="runner_right_col">
          <pose>0 -0.55 0.10 0 0 0</pose>
          <geometry><box><size>4.4 0.10 0.10</size></box></geometry>
        </collision>

        <!-- ===== Cross bars: tie the two runners together into one frame ===== -->
        <visual name="crossbar_front_vis">
          <pose>1.45 0 0.10 0 0 0</pose>
          <geometry><box><size>0.08 1.2 0.08</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
        <collision name="crossbar_front_col">
          <pose>1.45 0 0.10 0 0 0</pose>
          <geometry><box><size>0.08 1.2 0.08</size></box></geometry>
        </collision>
        <visual name="crossbar_rear_vis">
          <pose>-1.45 0 0.10 0 0 0</pose>
          <geometry><box><size>0.08 1.2 0.08</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
        <collision name="crossbar_rear_col">
          <pose>-1.45 0 0.10 0 0 0</pose>
          <geometry><box><size>0.08 1.2 0.08</size></box></geometry>
        </collision>

        <!-- ===== Sill supports  =====
             Measured with measure_skid_points.py: the scanned body is an open
             shell, so the posts stand under the lowest edge of the sills,
             between the wheel arches, at x = +-0.9 and y = +-0.81.

             Stack, from the floor:
               0.15        top of the skid runners
               0.15..0.23  sill cross bar (0.08 tall, sits on the runners)
               0.23..0.375 post (0.145 tall), top meets the sill edge

             Measured sill heights: 0.380, 0.376, 0.370 m, and 0.466 m at the
             rear left. The rear left value is a scan defect (a missing patch
             of the sill), since a real body is symmetric, so all four posts
             use 0.375 m and the small rear-left gap is documented. -->

        <!-- Cross bars sit on top of the runners and reach out under the sills -->
        <visual name="sill_bar_front_vis">
          <pose>0.9 0 0.19 0 0 0</pose>
          <geometry><box><size>0.08 1.7 0.08</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
        <collision name="sill_bar_front_col">
          <pose>0.9 0 0.19 0 0 0</pose>
          <geometry><box><size>0.08 1.7 0.08</size></box></geometry>
        </collision>
        <visual name="sill_bar_rear_vis">
          <pose>-0.9 0 0.19 0 0 0</pose>
          <geometry><box><size>0.08 1.7 0.08</size></box></geometry>
          <material><ambient>0.25 0.25 0.28 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
        <collision name="sill_bar_rear_col">
          <pose>-0.9 0 0.19 0 0 0</pose>
          <geometry><box><size>0.08 1.7 0.08</size></box></geometry>
        </collision>

        <!-- Four posts: 0.145 tall, centre z = 0.23 + 0.145/2 = 0.3025 -->
        <visual name="post_fl_vis">
          <pose>0.9 0.81 0.3025 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.145</size></box></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.85 0.55 0.15 1</diffuse></material>
        </visual>
        <collision name="post_fl_col">
          <pose>0.9 0.81 0.3025 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.145</size></box></geometry>
        </collision>
        <visual name="post_fr_vis">
          <pose>0.9 -0.81 0.3025 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.145</size></box></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.85 0.55 0.15 1</diffuse></material>
        </visual>
        <collision name="post_fr_col">
          <pose>0.9 -0.81 0.3025 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.145</size></box></geometry>
        </collision>
        <visual name="post_rl_vis">
          <pose>-0.9 0.81 0.3025 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.145</size></box></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.85 0.55 0.15 1</diffuse></material>
        </visual>
        <collision name="post_rl_col">
          <pose>-0.9 0.81 0.3025 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.145</size></box></geometry>
        </collision>
        <visual name="post_rr_vis">
          <pose>-0.9 -0.81 0.3025 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.145</size></box></geometry>
          <material><ambient>0.85 0.55 0.15 1</ambient><diffuse>0.85 0.55 0.15 1</diffuse></material>
        </visual>
        <collision name="post_rr_col">
          <pose>-0.9 -0.81 0.3025 0 0 0</pose>
          <geometry><box><size>0.08 0.08 0.145</size></box></geometry>
        </collision>

        <!-- ===== Roller conveyor rails: entry wall to exit wall (visual only) ===== -->
        <!-- 12 m long, under the skid runners, 0.05 m tall. Visual only: nothing
             needs to collide with it, and it keeps the physics cheap. -->
        <visual name="conveyor_left">
          <pose>0 0.55 0.025 0 0 0</pose>
          <geometry><box><size>12 0.14 0.05</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material>
        </visual>
        <visual name="conveyor_right">
          <pose>0 -0.55 0.025 0 0 0</pose>
          <geometry><box><size>12 0.14 0.05</size></box></geometry>
          <material><ambient>0.45 0.45 0.48 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material>
        </visual>

      </link>
    </model>

  </world>
</sdf>