<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="kr20_r3100">
  <!-- Import urdf file  -->
  <xacro:include filename="$(find yuktiikuka)/urdf/kr20_r3100_macro.xacro"/>
  <xacro:include filename="$(find yuktiikuka)/urdf/kr_iontec_ros2_control_macro.xacro"/>
  <xacro:include filename="$(find yuktiikuka)/urdf/gantry_macro.xacro"/>
  <!-- Read additional arguments  -->
  <xacro:arg name="driver_version" default="rsi_only"/>
  <!--<xacro:arg name="mode" default="hardware"/>-->
  <xacro:arg name="gpio_config" default=""/>
  <xacro:arg name="roundtrip_time" default="0"/>
  <xacro:arg name="client_ip" default="0.0.0.0"/>
  <xacro:arg name="client_port" default="59152"/>
  <xacro:arg name="mxa_client_port" default="1337"/>
  <xacro:arg name="controller_ip" default="0.0.0.0"/>
  <xacro:arg name="verify_robot_model" default="true"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="is_async" default="false"/>
  <xacro:arg name="async_thread_priority" default="69"/>
  <xacro:arg name="async_affinity" default="[]"/>
  <xacro:arg name="x" default="0"/>
  <xacro:arg name="y" default="0"/>
  <xacro:arg name="z" default="0"/>
  <xacro:arg name="roll" default="0"/>
  <xacro:arg name="pitch" default="0"/>
  <xacro:arg name="yaw" default="0"/>
  <xacro:arg name="rsi_xml_config_file" default=""/>
  <!--<xacro:kuka_iontec_ros2_control name="$(arg prefix)kr20_r3100" driver_version="$(arg driver_version)" client_ip="$(arg client_ip)" client_port="$(arg client_port)" mxa_client_port="$(arg mxa_client_port)" controller_ip="$(arg controller_ip)" prefix="$(arg prefix)" mode="$(arg mode)" gpio_config="$(arg gpio_config)" roundtrip_time="$(arg roundtrip_time)" verify_robot_model="$(arg verify_robot_model)" rsi_xml_config_file="$(arg rsi_xml_config_file)" is_async="$(arg is_async)" async_thread_priority="$(arg async_thread_priority)" async_affinity="$(arg async_affinity)">
    <ext_axes_ros2_control_joints/>
  </xacro:kuka_iontec_ros2_control> -->
  <!-- world link -->
  <link name="world"/>
  <!-- robot links, joints -->
  <xacro:xy_gantry prefix="$(arg prefix)"/>
  <xacro:kuka_kr20_r3100_robot prefix="$(arg prefix)" package_name="yuktiikuka"/>
    <!-- Arm hangs upside down under the carriage.
       rpy = pi 0 0: turned 180 degrees about x, so the arm's
       blue (z) axis now points DOWN toward the car. -->
  <joint name="$(arg prefix)mount_to_base_link" type="fixed">
    <parent link="$(arg prefix)arm_mount"/>
    <child link="$(arg prefix)base_link"/>
    <origin xyz="0 0 0" rpy="3.14159265 0 0"/>
  </joint>
        <!--Spray gun description-->
  <link name="spray_gun">
    <visual>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.30"/>
      </geometry>
      <material name="gun_gray">
       <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>

    <collision>
      <origin xyz="0 0 0.15" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.04" length="0.30"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0.15" rpy=" 0 0 0"/>
      <mass value="2.0"/>
      <!--ixx=iyy=m(3r^2 + L^2)/12, izz=m r^2/2-->
      <inertia ixx="0.0158" ixy="0.0" ixz="0.0"
               iyy="0.0158" iyz="0.0" 
               izz="0.0016"/>
    </inertial>
  </link>

  <!-- Gun to tool0-->
  <joint name="tool0_to_spray_gun" type="fixed">
    <parent link="$(arg prefix)tool0"/>
    <child link="spray_gun"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="paint_tcp"/>
  <!--Paint tool point center-->
  <joint name="spray_gun_to_paint_tcp" type="fixed">
    <parent link="spray_gun"/>
    <child link="paint_tcp"/>
    <origin xyz="0 0 0.55" rpy="0 0 0"/>
  </joint>

  <xacro:macro name="gz_joint" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>


  <!-- ros2_control for gazebo-->
  <ros2_control name="kr20_r3100_gazebo" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>

  <xacro:gz_joint name="$(arg prefix)joint_1" initial="0.0"/>
    <xacro:gz_joint name="$(arg prefix)joint_2" initial="-1.5708"/>  <!-- -90 deg -->
    <xacro:gz_joint name="$(arg prefix)joint_3" initial="1.5708"/>   <!-- +90 deg -->
    <xacro:gz_joint name="$(arg prefix)joint_4" initial="0.0"/>
    <xacro:gz_joint name="$(arg prefix)joint_5" initial="0.0"/>
    <xacro:gz_joint name="$(arg prefix)joint_6" initial="0.0"/>
    <xacro:gz_joint name="$(arg prefix)gantry_x_joint" initial="0.0"/>
    <xacro:gz_joint name="$(arg prefix)gantry_y_joint" initial="-1.5"/>
  </ros2_control>

    <!-- ============ Gazebo plugin ============ -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find yuktiikuka)/config/kr20_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
