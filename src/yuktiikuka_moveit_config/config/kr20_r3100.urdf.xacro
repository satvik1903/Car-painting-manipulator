<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="kr20_r3100">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import kr20_r3100 urdf file -->
    <xacro:include filename="$(find yuktiikuka)/urdf/kr20_r3100.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="kr20_r3100.ros2_control.xacro" />


    <xacro:kr20_r3100_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
