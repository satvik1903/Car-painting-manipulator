cd ~/Yuktii_Assesment
cat > .gitignore << 'EOF'
# ===== colcon build output (regenerated on every machine) =====
build/
install/
log/

# ===== Python =====
__pycache__/
*.pyc
tools/.venv/

# ===== Raw downloads (large, only needed once) =====
# The processed car meshes in src/yuktiikuka/meshes/car/ ARE committed.
models_raw/

# ===== Private files, not for a public repo =====
*.pdf
*.docx

# ===== Editor settings =====
.vscode/
EOF